{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Product Details{% endblock %}

{% block body %}
    <div class="content-header">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2>{{ product.name }}</h2>
                <nav class="breadcrumb-nav">
                    <a href="{{ path('admin_dashboard') }}" class="breadcrumb-link">Dashboard</a>
                    <span class="breadcrumb-separator">/</span>
                    <a href="{{ path('app_product_index') }}" class="breadcrumb-link">Products</a>
                    <span class="breadcrumb-separator">/</span>
                    <span class="breadcrumb-current">{{ product.name }}</span>
                </nav>
            </div>
            <div class="action-buttons">
                <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn-modern btn-warning">
                    <i class="fas fa-edit"></i> Edit
                </a>
            </div>
        </div>
    </div>

    <div class="content-body">
        <div class="row">
            <div class="col-lg-5">
                <div class="image-card">
                    {% if product.imageFilename %}
                        <img src="/uploads/products/{{ product.imageFilename }}" alt="{{ product.name }}" class="product-image">
                    {% else %}
                        <div class="no-image-large">
                            <i class="fas fa-image"></i>
                            <p>No Image Available</p>
                        </div>
                    {% endif %}
                </div>
            </div>
            <div class="col-lg-7">
                <div class="detail-card">
                    <div class="detail-header">
                        <h3>Product Information</h3>
                        <div class="product-status">
                        <span class="stock-badge {{ product.stock > 10 ? 'stock-good' : (product.stock > 0 ? 'stock-low' : 'stock-out') }}">
                            {% if product.stock == 0 %}
                                <i class="fas fa-times-circle"></i> Out of Stock
                            {% elseif product.stock <= 10 %}
                                <i class="fas fa-exclamation-triangle"></i> Low Stock
                            {% else %}
                                <i class="fas fa-check-circle"></i> In Stock
                            {% endif %}
                        </span>
                        </div>
                    </div>
                    <div class="detail-body">
                        <div class="detail-grid">
                            <div class="detail-item">
                                <label class="detail-label fw-bold">Product ID:</label>
                                <div class="detail-value">#{{ product.id }}</div>
                            </div>
                            <div class="detail-item">
                                <label class="detail-label fw-bold">Category</label>
                                <div class="detail-value">
                                    {% if product.category %}
                                        <span class="category-badge"><i class="fas fa-tag"></i> {{ product.category.name }}</span>
                                    {% else %}
                                        <span class="text-muted">No category assigned</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="detail-item">
                                <label class="detail-label fw-bold">Price</label>
                                <div class="detail-value">
                                    <span class="price-large">₹{{ product.price|number_format(2) }}</span>
                                </div>
                            </div>
                            <div class="detail-item">
                                <label class="detail-label fw-bold">Stock Quantity:</label>
                                <div class="detail-value">{{ product.stock }} units</div>
                            </div>
                            <div class="detail-item">
                                <label class="detail-label fw-bold">Description:</label>
                                <div class="detail-value">{{ product.description }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                <form method="post"
                      action="{{ path('app_product_delete', {'id': product.id}) }}"
                      onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');"
                      class="mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                    <button type="submit" class="btn-modern btn-danger">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
