{{ form_start(form) }}

<div class="form-group mb-3">
    {{ form_label(form.customerName) }}
    {{ form_widget(form.customerName) }}
    {{ form_errors(form.customerName) }}
</div>

<div class="form-group mb-3">
    {{ form_label(form.status) }}
    {{ form_widget(form.status) }}
    {{ form_errors(form.status) }}
</div>

<div class="form-group mb-3">
    {{ form_label(form.createdAt) }}
    {{ form_widget(form.createdAt) }}
    {{ form_errors(form.createdAt) }}
</div>

<div class="form-group mb-4">
    {{ form_label(form.products) }}
    <div class="product-selector-container">
        <!-- Search Input -->
        <div class="product-search-wrapper mb-3">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text"
                       id="productSearch"
                       class="form-control"
                       placeholder="Search products by name or category..."
                       autocomplete="off">
            </div>
        </div>

        <!-- Selected Products Display -->
        <div id="selectedProductsDisplay" class="selected-products-display mb-3" style="display: none;">
            <h6 class="selected-products-title">
                <i class="fas fa-shopping-cart me-2"></i>Selected Products
            </h6>
            <div id="selectedProductsList" class="selected-products-list"></div>
            <div class="order-summary mt-3">
                <div class="row">
                    <div class="col-md-6">
                        <strong>Total Items: <span id="totalItems">0</span></strong>
                    </div>
                    <div class="col-md-6 text-end">
                        <strong>Total Amount: ₹<span id="totalAmount">0.00</span></strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hidden Original Select (for form submission) -->
        <div style="display: none;">
            {{ form_widget(form.products) }}
        </div>

        <!-- Hidden inputs for quantities -->
        <div id="quantityInputs" style="display: none;"></div>

        <!-- Product Results/Grid -->
        <div id="productResults" class="product-results show-all"></div>

        <!-- Instructions -->
        <div class="product-selector-help">
            <small class="text-muted">
                <i class="fas fa-info-circle me-1"></i>
                Browse available products below or use search to filter. Click on products to add them to your order.
            </small>
        </div>
    </div>
    {{ form_errors(form.products) }}
</div>

<button type="submit" class="btn-modern btn-primary">
    <i class="fas fa-save me-2"></i>
    {{ button_label|default('Save Order') }}
</button>

{{ form_end(form) }}

<style>
    .product-selector-container {
        position: relative;
    }

    .product-search-wrapper .input-group-text {
        background-color: var(--gray-50);
        border-right: none;
        color: var(--gray-500);
    }

    .product-search-wrapper .form-control {
        border-left: none;
        background-color: var(--white);
    }

    .product-search-wrapper .form-control:focus {
        border-left: none;
        box-shadow: 0 0 0 3px rgb(79 70 229 / 0.1);
    }

    .product-results {
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: var(--border-radius);
        max-height: 400px;
        overflow-y: auto;
        box-shadow: var(--shadow-sm);
        margin-top: 8px;
    }

    .product-results.show-all {
        position: static;
        max-height: 500px;
        display: block !important;
    }

    .product-results.dropdown-mode {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1000;
        box-shadow: var(--shadow-md);
        margin-top: -1px;
    }

    .product-item {
        padding: 14px 16px;
        border-bottom: 1px solid var(--gray-100);
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .product-item:hover {
        background-color: var(--gray-50);
        border-left: 3px solid var(--primary-color);
    }

    .product-item:last-child {
        border-bottom: none;
    }

    .product-item.selected {
        background-color: #e7f1ff;
        border-left: 3px solid var(--primary-color);
    }

    .product-item.selected:hover {
        background-color: #dbeafe;
    }

    .product-item.out-of-stock {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .product-item.out-of-stock:hover {
        background-color: transparent;
        border-left: none;
    }

    .product-image {
        width: 40px;
        height: 40px;
        border-radius: 6px;
        background: var(--gray-100);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gray-400);
        font-size: 14px;
        flex-shrink: 0;
    }

    .product-details {
        flex: 1;
        min-width: 0;
    }

    .product-name {
        font-weight: 600;
        color: var(--gray-900);
        margin: 0;
        font-size: 14px;
        line-height: 1.4;
    }

    .product-meta {
        font-size: 12px;
        color: var(--gray-500);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 2px;
        flex-wrap: wrap;
    }

    .product-price {
        font-weight: 600;
        color: var(--success-color);
    }

    .product-stock {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .stock-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--success-color);
    }

    .stock-indicator.low {
        background-color: var(--warning-color);
    }

    .stock-indicator.out {
        background-color: var(--danger-color);
    }

    .selected-products-display {
        background: var(--gray-50);
        border: 1px solid var(--gray-200);
        border-radius: var(--border-radius);
        padding: 16px;
    }

    .selected-products-title {
        margin: 0 0 12px 0;
        font-size: 14px;
        font-weight: 600;
        color: var(--gray-700);
    }

    .selected-products-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .selected-product-item {
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: 8px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .selected-product-info {
        flex: 1;
        min-width: 0;
    }

    .selected-product-name {
        font-weight: 600;
        color: var(--gray-900);
        margin: 0;
        font-size: 14px;
    }

    .selected-product-price {
        color: var(--gray-600);
        font-size: 12px;
        margin-top: 2px;
    }

    .quantity-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--gray-300);
        border-radius: 6px;
        padding: 4px;
        background: var(--white);
    }

    .quantity-btn {
        width: 28px;
        height: 28px;
        border: none;
        background: var(--gray-100);
        color: var(--gray-600);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 12px;
        font-weight: bold;
    }

    .quantity-btn:hover:not(:disabled) {
        background: var(--primary-color);
        color: white;
    }

    .quantity-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .quantity-input {
        width: 50px;
        text-align: center;
        border: none;
        background: transparent;
        font-weight: 600;
        font-size: 14px;
        color: var(--gray-900);
    }

    .quantity-input:focus {
        outline: none;
    }

    .remove-product {
        background: transparent;
        border: none;
        color: var(--danger-color);
        cursor: pointer;
        font-size: 16px;
        line-height: 1;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        transition: all 0.2s ease;
    }

    .remove-product:hover {
        background: var(--danger-color);
        color: var(--white);
    }

    .order-summary {
        border-top: 1px solid var(--gray-200);
        padding-top: 12px;
        font-size: 14px;
    }

    .no-results {
        padding: 20px;
        text-align: center;
        color: var(--gray-500);
        font-size: 14px;
    }

    .product-selector-help {
        margin-top: 8px;
    }

    .out-of-stock-badge {
        background: var(--danger-color);
        color: white;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .product-item {
            padding: 10px 12px;
            gap: 10px;
        }

        .product-image {
            width: 35px;
            height: 35px;
        }

        .product-meta {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }

        .selected-product-item {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .quantity-controls {
            align-self: center;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('productSearch');
        const resultsContainer = document.getElementById('productResults');
        const selectedDisplay = document.getElementById('selectedProductsDisplay');
        const selectedList = document.getElementById('selectedProductsList');
        const originalSelect = document.querySelector('select[multiple]');
        const quantityInputsContainer = document.getElementById('quantityInputs');
        const totalItemsSpan = document.getElementById('totalItems');
        const totalAmountSpan = document.getElementById('totalAmount');

        let selectedProducts = new Map(); // productId -> {product, quantity}
        let allProducts = [];

        // Extract products from the original select options and preserve selected state
        function initializeProducts() {
            const options = originalSelect.querySelectorAll('option');
            allProducts = Array.from(options).map(option => ({
                id: option.value,
                name: option.textContent.split(' - $')[0] || option.textContent.split(' - ₹')[0],
                price: parseFloat(option.dataset.price || '0'),
                stock: parseInt(option.dataset.stock || '0'),
                category: option.dataset.category || 'No Category',
                image: option.dataset.image || 'default.jpg',
                element: option,
                selected: option.selected
            })).filter(product => product.id);

            // Initialize selectedProducts Map with pre-selected items (quantity 1)
            allProducts.forEach(product => {
                if (product.selected) {
                    selectedProducts.set(product.id, {
                        product: product,
                        quantity: 1
                    });
                }
            });

            console.log('Initialized products:', allProducts);
            console.log('Pre-selected products:', Array.from(selectedProducts.keys()));
        }

        function getAvailableStock(productId) {
            const product = allProducts.find(p => p.id === productId);
            if (!product) return 0;

            const selectedItem = selectedProducts.get(productId);
            const usedQuantity = selectedItem ? selectedItem.quantity : 0;

            return product.stock - usedQuantity;
        }

        function renderResults(products) {
            if (products.length === 0) {
                resultsContainer.innerHTML = '<div class="no-results"><i class="fas fa-search me-2"></i>No products found</div>';
                return;
            }

            resultsContainer.innerHTML = products.map(product => {
                const availableStock = getAvailableStock(product.id);
                const isSelected = selectedProducts.has(product.id);
                const isOutOfStock = availableStock <= 0 && !isSelected;

                return `
                <div class="product-item ${isSelected ? 'selected' : ''} ${isOutOfStock ? 'out-of-stock' : ''}"
                     data-product-id="${product.id}">
                    <div class="product-image">
                        <i class="fas fa-box"></i>
                    </div>
                    <div class="product-details">
                        <div class="product-name">${product.name}</div>
                        <div class="product-meta">
                            <span class="product-price">₹${product.price.toFixed(2)}</span>
                            <span>•</span>
                            <span>${product.category}</span>
                            <span>•</span>
                            <span class="product-stock">
                                <span class="stock-indicator ${availableStock <= 5 ? (availableStock === 0 ? 'out' : 'low') : ''}"></span>
                                ${availableStock} available
                            </span>
                            ${isSelected ? `<span>• <i class="fas fa-check text-success"></i> Selected (${selectedProducts.get(product.id).quantity})</span>` : ''}
                            ${isOutOfStock ? '<span class="out-of-stock-badge">Out of Stock</span>' : ''}
                        </div>
                    </div>
                </div>
            `;
            }).join('');
        }

        function updateTotals() {
            let totalItems = 0;
            let totalAmount = 0;

            selectedProducts.forEach(({product, quantity}) => {
                totalItems += quantity;
                totalAmount += product.price * quantity;
            });

            totalItemsSpan.textContent = totalItems;
            totalAmountSpan.textContent = totalAmount.toFixed(2);
        }

        function renderSelectedProducts() {
            if (selectedProducts.size === 0) {
                selectedDisplay.style.display = 'none';
                return;
            }

            selectedDisplay.style.display = 'block';

            const selectedProductsArray = Array.from(selectedProducts.values());

            selectedList.innerHTML = selectedProductsArray.map(({product, quantity}) => `
                <div class="selected-product-item">
                    <div class="selected-product-info">
                        <div class="selected-product-name">${product.name}</div>
                        <div class="selected-product-price">₹${product.price.toFixed(2)} each</div>
                    </div>
                    <div class="quantity-controls">
                        <button type="button" class="quantity-btn decrease-btn" data-product-id="${product.id}" ${quantity <= 1 ? 'disabled' : ''}>
                            −
                        </button>
                        <input type="number" class="quantity-input" value="${quantity}" min="1" max="${product.stock}" data-product-id="${product.id}" readonly>
                        <button type="button" class="quantity-btn increase-btn" data-product-id="${product.id}" ${quantity >= product.stock ? 'disabled' : ''}>
                            +
                        </button>
                    </div>
                    <button type="button" class="remove-product" data-product-id="${product.id}">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `).join('');

            updateTotals();
        }

        function updateFormInputs() {
            // Clear existing quantity inputs
            quantityInputsContainer.innerHTML = '';

            // Update original select
            allProducts.forEach(product => {
                product.element.selected = selectedProducts.has(product.id);
            });

            // Add hidden inputs for quantities
            selectedProducts.forEach(({product, quantity}, productId) => {
                const quantityInput = document.createElement('input');
                quantityInput.type = 'hidden';
                quantityInput.name = `product_quantities[${productId}]`;
                quantityInput.value = quantity;
                quantityInputsContainer.appendChild(quantityInput);
            });

            // Trigger change event
            originalSelect.dispatchEvent(new Event('change'));
        }

        function addProduct(productId) {
            const product = allProducts.find(p => p.id === productId);
            if (!product) return false;

            const availableStock = getAvailableStock(productId);
            if (availableStock <= 0) return false;

            selectedProducts.set(productId, {
                product: product,
                quantity: 1
            });

            updateFormInputs();
            renderSelectedProducts();
            return true;
        }

        function removeProduct(productId) {
            selectedProducts.delete(productId);
            updateFormInputs();
            renderSelectedProducts();
        }

        function changeQuantity(productId, newQuantity) {
            const selectedItem = selectedProducts.get(productId);
            if (!selectedItem) return;

            const product = selectedItem.product;
            newQuantity = Math.max(1, Math.min(newQuantity, product.stock));

            selectedProducts.set(productId, {
                product: product,
                quantity: newQuantity
            });

            updateFormInputs();
            renderSelectedProducts();

            // Re-render results to update available quantities
            const currentQuery = searchInput.value.toLowerCase();
            const productsToShow = currentQuery ?
                allProducts.filter(p =>
                    p.name.toLowerCase().includes(currentQuery) ||
                    p.category.toLowerCase().includes(currentQuery)
                ) : allProducts;
            renderResults(productsToShow);
        }

        // Initialize
        initializeProducts();
        renderResults(allProducts);
        renderSelectedProducts();
        resultsContainer.classList.add('show-all');

        // Search functionality
        searchInput.addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();

            if (query.length === 0) {
                renderResults(allProducts);
                resultsContainer.classList.remove('dropdown-mode');
                resultsContainer.classList.add('show-all');
                return;
            }

            resultsContainer.classList.remove('show-all');
            resultsContainer.classList.add('dropdown-mode');

            const filtered = allProducts.filter(product =>
                product.name.toLowerCase().includes(query) ||
                product.category.toLowerCase().includes(query)
            );

            renderResults(filtered);
        });

        // Handle clicks on search results
        resultsContainer.addEventListener('click', function(e) {
            const productItem = e.target.closest('.product-item');
            if (productItem && !productItem.classList.contains('out-of-stock')) {
                const productId = productItem.dataset.productId;

                if (selectedProducts.has(productId)) {
                    removeProduct(productId);
                } else {
                    addProduct(productId);
                }

                // Re-render results to update stock display
                const currentQuery = searchInput.value.toLowerCase();
                const productsToShow = currentQuery ?
                    allProducts.filter(p =>
                        p.name.toLowerCase().includes(currentQuery) ||
                        p.category.toLowerCase().includes(currentQuery)
                    ) : allProducts;
                renderResults(productsToShow);
            }
        });

        // Handle quantity controls
        selectedList.addEventListener('click', function(e) {
            const productId = e.target.closest('[data-product-id]')?.dataset.productId;
            if (!productId) return;

            if (e.target.closest('.remove-product')) {
                removeProduct(productId);

                // Re-render results
                const currentQuery = searchInput.value.toLowerCase();
                const productsToShow = currentQuery ?
                    allProducts.filter(p =>
                        p.name.toLowerCase().includes(currentQuery) ||
                        p.category.toLowerCase().includes(currentQuery)
                    ) : allProducts;
                renderResults(productsToShow);
            } else if (e.target.closest('.increase-btn')) {
                const currentQuantity = selectedProducts.get(productId).quantity;
                changeQuantity(productId, currentQuantity + 1);
            } else if (e.target.closest('.decrease-btn')) {
                const currentQuantity = selectedProducts.get(productId).quantity;
                changeQuantity(productId, currentQuantity - 1);
            }
        });

        // Hide results when clicking outside (only in dropdown mode)
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.product-selector-container') &&
                resultsContainer.classList.contains('dropdown-mode')) {
                resultsContainer.classList.remove('dropdown-mode');
                resultsContainer.classList.add('show-all');
                searchInput.value = '';
                renderResults(allProducts);
            }
        });

        // Handle search input focus
        searchInput.addEventListener('focus', function() {
            if (this.value.trim().length > 0) {
                resultsContainer.classList.remove('show-all');
                resultsContainer.classList.add('dropdown-mode');
            }
        });

        // Form submission validation
        document.querySelector('form').addEventListener('submit', function(e) {
            let hasOutOfStockItems = false;

            selectedProducts.forEach(({product, quantity}, productId) => {
                if (quantity > product.stock) {
                    hasOutOfStockItems = true;
                    alert(`Not enough stock for ${product.name}. Available: ${product.stock}, Requested: ${quantity}`);
                }
            });

            if (hasOutOfStockItems) {
                e.preventDefault();
                return false;
            }
        });
    });
</script>
